{
  "$id": "https://erp-insight-ai.local/contracts/analytics-stream-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Streaming variant of ``/query`` and ``/follow-up`` (give a parent to follow up).",
  "properties": {
    "connection_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Connection Id"
    },
    "conversation_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Conversation Id"
    },
    "parent_query_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Query Id"
    },
    "question": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Question",
      "type": "string"
    }
  },
  "required": [
    "question"
  ],
  "title": "StreamRequest",
  "type": "object"
}
