{
  "$id": "https://erp-insight-ai.local/contracts/feedback.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "categories": {
      "items": {
        "type": "string"
      },
      "title": "Categories",
      "type": "array"
    },
    "comment": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Comment"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "query_id": {
      "format": "uuid",
      "title": "Query Id",
      "type": "string"
    },
    "question": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Question"
    },
    "rating": {
      "title": "Rating",
      "type": "integer"
    },
    "remembered": {
      "default": false,
      "title": "Remembered",
      "type": "boolean"
    },
    "updated_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Updated At"
    },
    "user_id": {
      "format": "uuid",
      "title": "User Id",
      "type": "string"
    }
  },
  "required": [
    "id",
    "query_id",
    "user_id",
    "rating",
    "categories",
    "comment",
    "created_at",
    "updated_at"
  ],
  "title": "FeedbackOut",
  "type": "object"
}
