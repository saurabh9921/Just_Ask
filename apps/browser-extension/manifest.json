{
  "manifest_version": 3,
  "name": "ERP Insight AI",
  "short_name": "ERP Insight",
  "description": "Ask questions about your ERP data in plain English. Read-only, governed analytics.",
  "version": "0.5.0",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Open ERP Insight AI",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["sidePanel", "storage", "downloads"],
  "host_permissions": ["http://localhost:8080/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'self'; frame-ancestors 'none'"
  }
}
