# =============================================================================
# ERP Insight AI - environment template
#
#   cp .env.example .env        (or: python scripts/dev.py bootstrap - generates
#                                random secrets for you)
#
# NEVER commit .env. In production, inject these from a secret manager
# (Vault, AWS/GCP/Azure secret stores, Kubernetes Secrets + external-secrets).
# The API refuses to start with APP_ENV=production if JWT_SECRET/ENCRYPTION_KEY
# are defaults or shorter than 32 characters.
# =============================================================================

# ----------------------------------------------------------------------- app
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
LOG_JSON=true

# ------------------------------------------------------ infrastructure secrets
# Used by docker compose to initialise services. Compose builds the in-network
# connection URLs from these; the *_URL values below are for running the API
# directly on your host against the compose services (127.0.0.1 ports).
POSTGRES_APP_USER=app
POSTGRES_APP_PASSWORD=replace-in-development
POSTGRES_APP_DB=erp_insight
REDIS_PASSWORD=replace-in-development
QDRANT_API_KEY=
GRAFANA_ADMIN_PASSWORD=replace-in-development

# Host port of the platform's own PostgreSQL (use 5433 if a local PostgreSQL owns 5432).
# This database stores users, connections and audit - never your ERP data.
POSTGRES_HOST_PORT=5432

# Host-side URLs (API/worker run outside Docker). Keep passwords in sync with above.
APP_DATABASE_URL=postgresql+asyncpg://app:replace-in-development@127.0.0.1:5432/erp_insight
REDIS_URL=redis://:replace-in-development@127.0.0.1:6379/0
QDRANT_URL=http://127.0.0.1:6333

# ------------------------------------------------------------------ security
JWT_SECRET=replace-in-development
ENCRYPTION_KEY=replace-in-development
# Key rotation: set the new key above, ENCRYPTION_KEY_VERSION=<n+1> and the old key
# here, run `python -m app.cli rotate-secrets`, then clear ENCRYPTION_KEY_PREVIOUS.
ENCRYPTION_KEY_VERSION=1
ENCRYPTION_KEY_PREVIOUS=
# HashiCorp Vault (KV v2) for vault://<mount>/<VAULT_TENANT_PREFIX><name>#<field>
# secret references. Leave VAULT_ADDR empty to disable. Prefer VAULT_TOKEN_FILE
# (Vault Agent) over a static VAULT_TOKEN. Production requires https.
VAULT_ADDR=
VAULT_TOKEN=
VAULT_TOKEN_FILE=
VAULT_NAMESPACE=
VAULT_CA_CERT=
VAULT_TENANT_PREFIX=erp-insight/{tenant}/
JWT_ACCESS_TOKEN_TTL_SECONDS=600
JWT_REFRESH_TOKEN_TTL_SECONDS=43200
# Comma-separated. Chrome extension origin(s): chrome-extension://<extension-id>
CORS_ALLOWED_ORIGINS=

# Brute-force protection (per minute) and account lockout (exponential back-off)
LOGIN_RATE_LIMIT_PER_IP_PER_MINUTE=20
LOGIN_RATE_LIMIT_PER_ACCOUNT_PER_MINUTE=5
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_BASE_SECONDS=60
LOGIN_LOCKOUT_MAX_SECONDS=3600
PASSWORD_MIN_LENGTH=12

# --------------------------------------------------------- ERP connections
# Hosts/CIDRs the API must never connect to on a user's behalf (SSRF defence).
# Leave unset to use the built-in list (loopback, link-local/metadata, platform
# service names). In production ADD your platform's own database host(s), e.g.:
# CONNECTION_HOST_DENYLIST=localhost,127.0.0.0/8,::1/128,169.254.0.0/16,fe80::/10,0.0.0.0/8,metadata.google.internal,redis,qdrant,api,worker,nginx,prometheus,grafana,vllm,ollama,postgres
# Unset = allowed outside production, forbidden in production.
ALLOW_INSECURE_CONNECTION_TLS=
SQLITE_CONNECTIONS_ENABLED=
SQLITE_DATA_DIR=./data/sqlite
CONNECTOR_CONNECT_TIMEOUT_SECONDS=10
# inline = run metadata sync, semantic ingestion and exports inside the API process (host-run dev); celery = worker
METADATA_SYNC_MODE=inline
# Oracle / SAP HANA are connector FOUNDATIONS (not production ready): off by default.
ENABLE_FOUNDATION_CONNECTORS=false
SQLSERVER_ODBC_DRIVER=ODBC Driver 18 for SQL Server
# Per-connection circuit breaker and concurrency queue
CONNECTOR_BREAKER_FAILURES=5
CONNECTOR_BREAKER_RESET_SECONDS=30
CONNECTOR_QUEUE_TIMEOUT_SECONDS=10

# --------------------------------------------------------------- query guard
MAX_QUERY_ROWS=1000
MAX_QUERY_SECONDS=30
MAX_AGENT_STEPS=12
QUERY_CACHE_TTL_SECONDS=300
QUERY_RESULT_CACHE_ENABLED=true
# Shared by all users of a tenant (per-user limits still apply)
QUERY_RATE_LIMIT_PER_TENANT_PER_MINUTE=600
METADATA_CACHE_TTL_SECONDS=900
RETRIEVAL_CACHE_TTL_SECONDS=600

# ------------------------------------------------------------------ exports
# Files live here until EXPORT_TTL_SECONDS after completion (purged by the scheduler).
EXPORT_DIR=./data/exports
EXPORT_MAX_ROWS=100000
EXPORT_TTL_SECONDS=3600
EXPORT_MAX_ACTIVE_PER_USER=2
EXPORT_TIMEOUT_SECONDS=600

# ----------------------------------------------------------------------- LLM
# mock    - deterministic, no model needed (default for CPU-only development/tests)
# ollama  - local developer models:  docker compose --profile ollama up -d
# vllm    - GPU serving (OpenAI-compatible): docker compose --profile vllm up -d
# external- third-party hosted API; also requires EXTERNAL_LLM_ENABLED=true
LLM_PROVIDER=mock
LLM_BASE_URL=http://ollama:11434
LLM_MODEL=your-local-model
LLM_API_KEY=local-development-key
EXTERNAL_LLM_ENABLED=false

# vLLM profile only: the model to load (HF repo id or local path) and GPU sizing.
# For vLLM set LLM_BASE_URL=http://vllm:8000/v1 and LLM_PROVIDER=vllm.
VLLM_MODEL=
VLLM_MAX_MODEL_LEN=16384
VLLM_GPU_MEMORY_UTILIZATION=0.90
VLLM_GPU_COUNT=1
HF_TOKEN=

LLM_MAX_RETRIES=2
LLM_CIRCUIT_FAILURE_THRESHOLD=5
LLM_CIRCUIT_RESET_SECONDS=30

# Embeddings
# hashing           - deterministic, no model; development/tests only (refused in production)
# openai_compatible - POST {EMBEDDING_BASE_URL}/embeddings (vLLM, TEI, llama.cpp, Ollama /v1)
# ollama            - POST {EMBEDDING_BASE_URL}/api/embed
# EMBEDDING_DIMENSIONS must equal the model's output size (checked on every response and
# against existing Qdrant collections). Changing the model requires a re-index.
EMBEDDING_PROVIDER=hashing
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=your-embedding-model
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=64

# Reranking of fused candidates: lexical (built-in) or http (Jina/vLLM-style /rerank)
RERANKER_ENABLED=true
RERANKER_PROVIDER=lexical
RERANKER_BASE_URL=
RERANKER_MODEL=your-reranker-model

# --------------------------------------------------------------------- RAG
# Leave unset to use <repo>/semantic-layer (containers set /srv/semantic-layer)
SEMANTIC_LAYER_PATH=
# QDRANT_URL=:memory: runs an in-process vector store (Docker-less development only)
QDRANT_COLLECTION_PREFIX=erp_
RAG_TOP_K=8
RAG_CANDIDATE_K=40
RAG_RRF_K=60

# ------------------------------------------------------------- observability
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# ------------------------------------------------------------------- compose
# Origin the browser extension is built for (python scripts/dev.py ext-build).
# Empty = http://localhost:8080 (development). Production: https://your-host
EXTENSION_API_ORIGIN=
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
IMAGE_TAG=dev
